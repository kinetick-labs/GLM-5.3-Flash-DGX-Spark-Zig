# Optional overrides for scripts/build.sh and scripts/serve.sh (export them, or `set -a; . ./.env`).
# TF_DIR=$HOME/TensorFold-glm53       # clone of kinetick-labs/TensorFold
# TF_BRANCH=feat/glm53-rexl3
# TF_REF=2f01cde2e                    # pinned branch commit
# ROOT=$HOME/tf-glm53-serve           # stable install root: bin/, libs/, COMMIT
# LIBS_FROM=/path/to/libs             # libtfgrammar.so, libturbojpeg.so*, libwebpdecoder.so*
# PORT=8094
# IMAGE=tensorfold-zig:runtime-pt2607 # runtime image (scripts/build-image.sh; CUDA 13 libs, aarch64)
# MODEL=$HOME/models/GLM-5.3-Flash-SAGE-REXL3-2.48bpw
# DFLASH=$HOME/models/glm53-dflash2
# KV_SHARE=4                          # kept conversation states; 2 = ~0.4 GiB more MemAvailable margin
